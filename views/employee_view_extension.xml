<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_asset_label" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.asset.label</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_employee_assets" 
                        class="oe_stat_button" 
                        icon="fa-barcode" 
                        type="object"
                        groups="Inventario.group_inventory_manager"
                        help="Ver perfil de activos de este empleado">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="asset_count"/></span>
                        <span class="o_stat_text">Activos</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
