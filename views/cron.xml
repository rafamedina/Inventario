<odoo>
    <data noupdate="1">
        <record id="ir_cron_check_maintenance" model="ir.cron">
            <field name="name">Inventario: Comprobar Mantenimientos</field>
            <field name="model_id" ref="model_inventory_asset"/>
            <field name="state">code</field>
            <field name="code">model.check_maintenance_dates()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>