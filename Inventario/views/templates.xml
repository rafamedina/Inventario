<odoo>
    <data>
        <!-- Formato de papel para etiquetas pequeñas (50x30mm) -->
        <record id="paperformat_asset_label" model="report.paperformat">
            <field name="name">Etiqueta de Activo (50x30mm)</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">30</field>
            <field name="page_width">50</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">2</field>
            <field name="margin_bottom">2</field>
            <field name="margin_left">2</field>
            <field name="margin_right">2</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">96</field>
        </record>

        <!-- Plantilla QWeb para la etiqueta -->
        <template id="report_asset_label_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div style="text-align: center; font-family: 'Monospace'; font-size: 14px; font-weight: bold; border: 1px solid black; padding: 5px; height: 26mm; display: flex; align-items: center; justify-content: center;">
                                <span t-field="o.identificador_final"/>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- Acción de Reporte -->
        <record id="action_report_asset_label" model="ir.actions.report">
            <field name="name">Imprimir Etiqueta ID</field>
            <field name="model">inventory.asset</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">Inventario.report_asset_label_template</field>
            <field name="report_file">Inventario.report_asset_label_template</field>
            <field name="print_report_name">'Etiqueta_%s' % (object.identificador_final)</field>
            <field name="binding_model_id" ref="model_inventory_asset"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_asset_label"/>
        </record>
    </data>
</odoo>
