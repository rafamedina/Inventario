<odoo>
    <data>
        <!-- Formato de papel A4 estándar para evitar reescalados -->
        <record id="paperformat_asset_label" model="report.paperformat">
            <field name="name">Etiqueta en A4 (Sin reescalado)</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">96</field>
        </record>

        <!-- Plantilla QWeb en A4 con texto de tamaño controlado -->
        <template id="report_asset_label_template">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <!-- Bloque de la etiqueta con tamaño fijo (ej. 50x20mm) dentro del A4 -->
                        <div style="width: 50mm; height: 20mm; border: 1px dashed #ccc; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                            <div style="text-align: center; font-family: 'Arial', sans-serif; font-size: 12px; font-weight: bold; line-height: 1.2;">
                                <span t-field="o.identificador_final"/>
                            </div>
                        </div>
                        <p style="font-size: 10px; color: #666; margin-top: 5px;">Recorte por la línea punteada para obtener su etiqueta.</p>
                    </div>
                </t>
            </t>
        </template>

        <!-- Acción de Reporte -->
        <record id="action_report_asset_label" model="ir.actions.report">
            <field name="name">Imprimir Etiqueta ID</field>
            <field name="model">inventory.asset</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">Inventario.report_asset_label_template</field>
            <field name="report_file">Inventario.report_asset_label_template</field>
            <field name="print_report_name">'Etiqueta_%s' % (object.identificador_final)</field>
            <field name="binding_model_id" ref="model_inventory_asset"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_asset_label"/>
        </record>
    </data>
</odoo>
