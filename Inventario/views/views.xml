<odoo>
  <data>

    <!-- ==========================================
         VISTAS PARA CATEGORÍAS
         ========================================== -->
    <record id="view_inventory_category_tree" model="ir.ui.view">
        <field name="name">inventory.category.tree</field>
        <field name="model">inventory.category</field>
        <field name="arch" type="xml">
            <tree string="Categorías">
                <field name="codigo"/>
                <field name="nombre"/>
                <field name="descripcion"/>
            </tree>
        </field>
    </record>
    <record id="view_inventory_category_form" model="ir.ui.view">
        <field name="name">inventory.category.form</field>
        <field name="model">inventory.category</field>
        <field name="arch" type="xml">
            <form string="Categoría">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" invisible="active == True"/>
                    <group>
                        <field name="active" invisible="1"/>
                        <field name="nombre"/>
                        <field name="codigo"/>
                        <field name="descripcion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==========================================
         VISTAS PARA SUBCATEGORÍAS
         ========================================== -->
    <record id="view_inventory_subcategory_tree" model="ir.ui.view">
        <field name="name">inventory.subcategory.tree</field>
        <field name="model">inventory.subcategory</field>
        <field name="arch" type="xml">
            <tree string="Subcategorías">
                <field name="categoria_id"/>
                <field name="codigo"/>
                <field name="nombre"/>
                <field name="descripcion"/>
            </tree>
        </field>
    </record>

    <record id="view_inventory_subcategory_search" model="ir.ui.view">
        <field name="name">inventory.subcategory.search</field>
        <field name="model">inventory.subcategory</field>
        <field name="arch" type="xml">
            <search string="Buscar Subcategorías">
                <field name="nombre"/>
                <field name="codigo"/>
                <field name="categoria_id"/>
                <separator/>
                <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Categoría" name="group_by_category" context="{'group_by': 'categoria_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_inventory_subcategory_form" model="ir.ui.view">
        <field name="name">inventory.subcategory.form</field>
        <field name="model">inventory.subcategory</field>
        <field name="arch" type="xml">
            <form string="Subcategoría">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" invisible="active == True"/>
                    <group>
                        <field name="active" invisible="1"/>
                        <field name="categoria_id"/>
                        <field name="nombre"/>
                        <field name="codigo"/>
                        <field name="descripcion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==========================================
         VISTAS PARA LOCALIZACIONES
         ========================================== -->
    <record id="view_inventory_location_tree" model="ir.ui.view">
        <field name="name">inventory.location.tree</field>
        <field name="model">inventory.location</field>
        <field name="arch" type="xml">
            <tree string="Localizaciones">
                <field name="codigo"/>
                <field name="nombre"/>
                <field name="descripcion"/>
            </tree>
        </field>
    </record>
    <record id="view_inventory_location_form" model="ir.ui.view">
        <field name="name">inventory.location.form</field>
        <field name="model">inventory.location</field>
        <field name="arch" type="xml">
            <form string="Localización">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" invisible="active == True"/>
                    <group>
                        <field name="active" invisible="1"/>
                        <field name="nombre"/>
                        <field name="codigo"/>
                        <field name="descripcion"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==========================================
         VISTAS PARA EL ACTIVO (InventoryAsset)
         ========================================== -->
    <record id="view_inventory_asset_tree" model="ir.ui.view">
        <field name="name">inventory.asset.tree</field>
        <field name="model">inventory.asset</field>
        <field name="arch" type="xml">
            <tree string="Inventario" decoration-danger="estado_mantenimiento == 'vencido'" decoration-warning="estado_mantenimiento == 'proximo'">
                <field name="identificador_final" decoration-bf="1"/> 
                <field name="nombre"/>
                <field name="categoria_id"/> 
                <field name="subcategoria_id"/> 
                <field name="ubicacion_id"/> 
                <field name="estado_mantenimiento" column_invisible="True"/>
                <field name="responsable_display"/>
                <field name="propietario_display" optional="show"/>
                <field name="plan_id" widget="badge" decoration-info="1"/>
                <field name="proximo_mantenimiento" widget="remaining_days"/>                
            </tree>
        </field>
    </record>

    <record id="view_inventory_asset_form" model="ir.ui.view">
        <field name="name">inventory.asset.form</field>
        <field name="model">inventory.asset</field>
        <field name="arch" type="xml">
            <form string="Activo">
                <header>
                    <button name="action_maintenance_done" string="Registrar Mantenimiento" type="object" class="oe_highlight"/>
                    <!-- Botón para imprimir la etiqueta en A4 -->
                    <button name="%(action_report_asset_label)d" string="Imprimir ID" type="action" class="oe_highlight"/>
                    <!-- QR Code movido al reporte de etiqueta A4 -->

                    
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivado (Baja)" bg_color="bg-danger" invisible="active == True"/>
                    
                    <div class="oe_button_box" name="button_box">
                        <!-- Box de botones vacío o para otras estadísticas futuras -->
                    </div>

                    <div class="oe_title">
                        <label for="nombre" class="oe_edit_only"/>
                        <h1><field name="nombre" placeholder="Ej. Servidor Principal"/></h1>
                        <h3><field name="identificador_final" readonly="1" class="text-info"/></h3>
                    </div>
                    <group>
                        <group string="Clasificación">
                            <field name="active" invisible="1"/>
                            
                            <field name="categoria_id" widget="selection"/>
                            <field name="subcategoria_id" widget="selection"/>
                            <field name="ubicacion_id" widget="selection"/>
                            <field name="anio_inclusion"/>
                            
                            <field name="tipo"/>
                            <field name="localizacion"/>
                        </group>
                        <group string="Responsable y Propietario">
                            <field name="tipo_responsable" widget="radio" options="{'horizontal': true}"/>
                            <field name="responsable_empleado_id" invisible="tipo_responsable != 'empleado'"/>
                            <field name="responsable_departamento_id" invisible="tipo_responsable != 'departamento'"/>
                            <hr colspan="2"/>
                            <field name="tipo_propietario" widget="radio" options="{'horizontal': true}"/>
                            <field name="propietario_empleado_id" invisible="tipo_propietario != 'empleado'"/>
                            <field name="propietario_departamento_id" invisible="tipo_propietario != 'departamento'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detalles Técnicos y Mantenimiento">
                            <group>
                                <group string="Hardware y Software">
                                    <field name="hardware"/>
                                    <field name="os"/>
                                    <field name="version"/>
                                </group>
                                <group string="Mantenimiento">
                                    <field name="plan_id"/> 
                                    <field name="ultimomantenimiento"/> 
                                    <field name="proximo_mantenimiento"/>
                                </group>
                            </group>
                        </page>
                        <page string="Descripción y Detalles">
                             <field name="descripcion"/>
                             <separator string="Detalles Adicionales"/>
                             <field name="detalles_adicionales"/>
                             <separator string="Observaciones"/>
                             <field name="notas"/>
                        </page>
                        <!-- NUEVA PESTAÑA: Trazabilidad -->
                        <page string="Historial de Asignaciones">
                            <field name="history_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="old_employee_id"/>
                                    <field name="new_employee_id"/>
                                    <field name="role"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Código UUID Interno">
                            <group>
                                <field name="uuid_activo"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ==========================================
         VISTAS PARA EL PLAN DE MANTENIMIENTO
         ========================================== -->
    <record id="view_plans_asset_form" model="ir.ui.view">
        <field name="name">plans.asset.form</field>
        <field name="model">plans.asset</field>
        <field name="arch" type="xml">
            <form string="Plan de Mantenimiento">
                <sheet>
                    <widget name="web_ribbon" title="Archivado (Baja)" bg_color="bg-danger" invisible="active == True"/>
                    <div class="oe_title">
                        <h1><field name="identificador"/></h1>
                        <h2><field name="nombre" placeholder="Ej. Revisión Servidores"/></h2>
                    </div>
                    <group>
                        <group string="Configuración Principal">
                            <field name="active" invisible="1"/>
                            <field name="categoria_id" widget="selection"/>
                            <field name="subcategoria_id" widget="selection"/>
                            <field name="periodicidad"/>
                        </group>
                        <group string="Alertas de Atraso">
                            <field name="alerta_recurrente"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lista de Tareas (Checklist)">
                            <field name="tarea_ids">
                                <tree editable="bottom">
                                    <field name="name" string="Descripción de la tarea"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Alertas Previas (Notificaciones)">
                            <field name="alerta_ids">
                                <tree editable="bottom">
                                    <field name="valor" string="Avisar"/>
                                    <field name="unidad" string="Unidad de tiempo"/>
                                    <field name="name" column_invisible="True"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="view_plans_asset_tree" model="ir.ui.view">
        <field name="name">plans.asset.tree</field>
        <field name="model">plans.asset</field>
        <field name="arch" type="xml">
            <tree string="Planes">
                <field name="identificador" decoration-bf="1"/>
                <field name="nombre"/>
                <field name="categoria_id"/>
                <field name="subcategoria_id"/>
                <field name="periodicidad"/>
            </tree>
        </field>
    </record>

    <!-- ==========================================
         HERENCIA DE EMPLEADOS (hr.employee)
         ========================================== -->
    <!-- Vista de formulario para el Inventario: conserva la cabecera estándar de Odoo pero simplifica el contenido -->
    <record id="view_employee_form_inventory_simple" model="ir.ui.view">
        <field name="name">hr.employee.form.inventory.simple</field>
        <field name="model">hr.employee</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <form string="Empleado (Trazabilidad)">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Nombre del Empleado" readonly="1"/></h1>
                        <h3><field name="job_title" placeholder="Puesto de trabajo" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="work_email" readonly="1"/>
                            <field name="work_phone" readonly="1"/>
                        </group>
                        <group>
                            <field name="department_id" readonly="1"/>
                            <field name="parent_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Activos Asignados (Inventario)" name="inventory_assets">
                            <separator string="Responsabilidades Actuales"/>
                            <field name="current_responsible_asset_ids" readonly="1">
                                <tree>
                                    <field name="identificador_final"/>
                                    <field name="nombre"/>
                                    <field name="categoria_id"/>
                                    <field name="subcategoria_id"/>
                                </tree>
                            </field>
                            <separator string="Propiedades Actuales"/>
                            <field name="current_owner_asset_ids" readonly="1">
                                <tree>
                                    <field name="identificador_final"/>
                                    <field name="nombre"/>
                                    <field name="categoria_id"/>
                                    <field name="subcategoria_id"/>
                                </tree>
                            </field>
                            <separator string="Historial de Asignaciones (Pasadas y Presentes)"/>
                            <field name="asset_history_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="identificador_final" string="ID Activo"/>
                                    <field name="asset_id" string="Nombre" optional="hide"/>
                                    <field name="role"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Filtros en la vista búsqueda de empleados -->
    <record id="view_employee_filter_inherit_inventory" model="ir.ui.view">
        <field name="name">hr.employee.search.inherit.inventory</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter string="Con Activos Asignados (Responsable)" name="has_responsible_assets" domain="[('current_responsible_asset_ids', '!=', False)]"/>
                <filter string="Con Activos Asignados (Propietario)" name="has_owned_assets" domain="[('current_owner_asset_ids', '!=', False)]"/>
                <filter string="Tuvo Activos Históricamente" name="had_assets_history" domain="[('asset_history_ids', '!=', False)]"/>
            </xpath>
        </field>
    </record>

    <!-- ==========================================
         ACCIONES Y MENÚS
         ========================================== -->
    <record id="action_inventory_asset" model="ir.actions.act_window">
        <field name="name">Inventario de Activos</field>
        <field name="res_model">inventory.asset</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_plans_asset" model="ir.actions.act_window">
        <field name="name">Planes de Mantenimiento</field>
        <field name="res_model" >plans.asset</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <record id="action_inventory_category" model="ir.actions.act_window">
        <field name="name">Categorías</field>
        <field name="res_model">inventory.category</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_inventory_subcategory" model="ir.actions.act_window">
        <field name="name">Subcategorías</field>
        <field name="res_model">inventory.subcategory</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_inventory_location" model="ir.actions.act_window">
        <field name="name">Localizaciones</field>
        <field name="res_model">inventory.location</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Acción para Empleados: Forzamos el uso de las vistas estándar para kanban/lista y la simplificada para el formulario -->
    <record id="action_inventory_employee" model="ir.actions.act_window">
        <field name="name">Empleados</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_has_responsible_assets': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Administra los empleados y su vinculación con los activos.
            </p>
        </field>
    </record>

    <!-- Definimos específicamente qué vista usar para cada modo en esta acción -->
    <record id="action_inventory_employee_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="hr.hr_kanban_view_employees"/>
        <field name="act_window_id" ref="action_inventory_employee"/>
    </record>

    <record id="action_inventory_employee_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="hr.view_employee_tree"/>
        <field name="act_window_id" ref="action_inventory_employee"/>
    </record>

    <record id="action_inventory_employee_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_employee_form_inventory_simple"/>
        <field name="act_window_id" ref="action_inventory_employee"/>
    </record>

    <menuitem id="menu_inventory_root" name="Gestión de Activos" sequence="10"/>
    
    <menuitem id="menu_operations" name="Operaciones" parent="menu_inventory_root" sequence="1"/>
    <menuitem id="menu_asset_list" name="Inventario" parent="menu_operations" action="action_inventory_asset" sequence="1"/>
    <menuitem id="menu_inventory_employees" name="Empleados" parent="menu_operations" action="action_inventory_employee" sequence="2"/>
    
    <menuitem id="menu_maintenance_root" name="Mantenimiento" parent="menu_inventory_root" sequence="2"/>
    <menuitem id="menu_plans_list" name="Planes" parent="menu_maintenance_root" action="action_plans_asset" sequence="1"/>

    <menuitem id="menu_configuration_root" name="Configuración" parent="menu_inventory_root" sequence="100"/>
    <menuitem id="menu_config_categories" name="Categorías" parent="menu_configuration_root" action="action_inventory_category" sequence="1"/>
    <menuitem id="menu_config_subcategories" name="Subcategorías" parent="menu_configuration_root" action="action_inventory_subcategory" sequence="2"/>
    <menuitem id="menu_config_locations" name="Localizaciones" parent="menu_configuration_root" action="action_inventory_location" sequence="3"/>

  </data>
</odoo>
