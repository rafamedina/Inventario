<odoo>
    <data>
        <record id="module_category_inventory" model="ir.module.category">
            <field name="name">Gestión de Inventario</field>
            <field name="description">Categoría para el módulo de inventario de activos.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_inventory_manager" model="res.groups">
            <field name="name">Inventory / Full Access</field>
            <field name="category_id" ref="module_category_inventory"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Acceso total al módulo de inventario.</field>
        </record>
    </data>
</odoo>
