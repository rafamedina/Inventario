<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for PlansAsset -->
        <record id="seq_plans_asset" model="ir.sequence">
            <field name="name">Plans Asset Sequence</field>
            <field name="code">plans.asset.sequence</field>
            <field name="prefix">PLAN-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for InventoryAsset -->
        <record id="seq_inventory_asset" model="ir.sequence">
            <field name="name">Inventory Asset Sequence</field>
            <field name="code">inventory.asset.sequence</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
